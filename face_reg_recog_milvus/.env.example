# Hostnames below point at localhost so that a locally-run `uvicorn app.server:app`
# talks to the published container ports. docker-compose overrides them with the
# compose service names for the containerised api, via `environment:`.

# fastapi
FASTAPI_SERVER_PORT=8080
# triton inference server (grpc)
TRITON_SERVER_HOST=localhost
TRITON_SERVER_PORT=8001
# storage paths for a local run; the api container overrides these to /data/*
DOWNLOAD_CACHE_PATH="app/.data"
DOWNLOAD_IMAGE_PATH="volumes/person_images"
LOG_STORAGE_PATH="volumes/server_logs"
# face pipeline -- one detector + one recogniser, chosen at startup.
# detectors:   scrfd_10g | yunet | yolo11n_face_5kp
# recognizers: arcface_r50 | auraface_glintr100 | lvface_b
# Changing FACE_RECOGNIZER switches to a different Milvus collection, because
# embeddings from different models are not comparable.
FACE_DETECTOR=scrfd_10g
FACE_RECOGNIZER=arcface_r50
FACE_DET_THRESHOLD=0.5
FACE_MATCH_THRESHOLD=0.4

# milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
ATTU_PORT=3000
# mysql mariadb
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=user
MYSQL_PASSWORD=pass
MYSQL_ROOT_PASSWORD=admin
MYSQL_DATABASE=default
MYSQL_PERSON_TABLE=person
# phpmyadmin gui (8001 is taken by triton grpc)
PMA_GUI_PORT=8081
# redis
REDIS_HOST=localhost
REDIS_PORT=6379
